# frozen_string_literal: true

source 'https://rubygems.org'

gemspec path: '..'

gem 'rails', '~> 7.2.0'

gem 'rspec', '~> 3.13'
gem 'rspec-rails', '~> 7.1'

gem 'sqlite3', '~> 2.8'

gem 'simplecov', '~> 1.0', require: false
gem 'simplecov-json', '~> 0.2', require: false

gem 'capybara', '~> 3.40'
gem 'selenium-webdriver', '~> 4.27'

gem 'importmap-rails', '~> 2.1'
gem 'propshaft', '~> 1.1'
gem 'stimulus-rails', '~> 1.3'
gem 'turbo-rails', '~> 2.0'

gem 'puma', '~> 8.0'

# ActiveSupport 7.x passes quirks_mode, which json 3 rejects
gem 'json', '~> 2.21'
