<section class="mx-auto max-w-lg rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <header class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900">Todos</h1>
    <span class="text-sm text-gray-500" data-testid="remaining"><%= remaining %> left</span>
  </header>

  <form class="mb-4 flex gap-2" live-form="add" data-testid="add-form">
    <input name="title" class="flex-1 rounded border border-gray-300 px-3 py-2" placeholder="What needs doing?" data-testid="new-title">
    <button type="submit" class="rounded bg-indigo-600 px-4 py-2 text-white">Add</button>
  </form>

  <nav class="mb-4 flex gap-2 text-sm">
    <% %w[all active done].each do |name| %>
      <button live-key="<%= name %>" live-action="show" live-value-filter="<%= name %>"
        class="rounded px-3 py-1 <%= filter == name ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
        <%= name.capitalize %>
      </button>
    <% end %>
  </nav>

  <% if visible_todos.any? %>
    <ul class="divide-y divide-gray-100" data-testid="todos">
      <% visible_todos.each do |todo| %>
        <li id="todo-<%= todo['id'] %>" class="flex items-center gap-3 py-3" data-testid="todo">
          <input type="checkbox" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
            live-action="change->toggle" live-value-id="<%= todo['id'] %>" <%= 'checked' if todo['done'] %>>
          <% if todo['done'] %>
            <span class="flex-1 text-gray-400 line-through" data-testid="title"><%= todo['title'] %></span>
          <% else %>
            <span class="flex-1 text-gray-900" data-testid="title"><%= todo['title'] %></span>
          <% end %>
          <button class="text-sm text-red-500 hover:text-red-700" live-action="remove" live-value-id="<%= todo['id'] %>">
            Remove
          </button>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="py-8 text-center text-gray-400" data-testid="empty">Nothing to do.</p>
  <% end %>

  <svg class="mt-4 h-2 w-full" data-testid="dots">
    <% visible_todos.each do |todo| %>
      <circle id="dot-<%= todo['id'] %>" cx="<%= todo['id'] * 12 %>" cy="4" r="4"></circle>
    <% end %>
  </svg>

  <footer class="mt-4 flex justify-end">
    <button class="text-sm text-gray-500 hover:text-gray-700" live-action="clear_done">Clear completed</button>
  </footer>
</section>
