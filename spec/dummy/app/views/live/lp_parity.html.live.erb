<div>
  <%= render 'live/lp_parity/badge', label: title, n: count %>
  <p>before <%= render 'live/lp_parity/badge', label: 'x', n: 1 %> after</p>
  <ul>
    <% [1, 2].each do |i| %>
      <li><%= render 'live/lp_parity/badge', label: "i#{i}", n: i %></li>
    <% end %>
  </ul>
  <% if count > 0 %>
    <%= render 'live/lp_parity/badge', label: 'in if', n: count %>
  <% else %>
    none
  <% end %>
  <%= render 'live/lp_parity/panel', show: true, body: title %>
  <%= render 'live/lp_parity/panel', show: false, body: '' %>
  <%- if count > 0 -%>
    <%= render 'live/lp_parity/badge', label: 'trim', n: 3 -%>
  <%- end -%>
  <% x = 1 %><%= render 'live/lp_parity/word' %>
  <%= render 'live/lp_parity/word' %>
  <%= render 'live/lp_parity/word' %>
  <%= render 'live/lp_parity/word' %><% y = 2 %>
  <%= render 'live/lp_parity/word' %>  <% z = 3 %>
  <%= render 'live/lp_parity/word' -%>
  after trim
  <%== render 'live/lp_parity/raw' %>
  <span><%= render 'live/lp_parity/spaced' %></span>
  <%= tag.div(class: 'wrap') do %>
    <%= render 'live/lp_parity/badge', label: 'in tag', n: 2 %>
  <% end %>
  <%= form_with url: '/items', scope: :item do |f| %>
    <%= render 'live/lp_parity/field', f: %>
  <% end %>
  <%= render 'live/lp_parity/assigns', label: 'a' %>
  <%= render 'live/lp_parity/assigns', label: 'b', tone: 'warn' %>
  <%= render partial: 'live/lp_parity/item', object: title %>
  <%= render partial: 'live/lp_parity/item', object: 'named', as: :item %>
  <ol><%= render partial: 'live/lp_parity/row', collection: [title, 'b', 'c'], as: :entry %></ol>
  <ol><%= render partial: 'live/lp_parity/row', collection: [], as: :entry %></ol>
  <%= render 'live/lp_parity/outer', label: title %>
  <p><%= x + y + z %></p>
</div>
