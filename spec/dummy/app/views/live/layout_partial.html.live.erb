<div data-testid="layout-partial">
  <%= render layout: 'shared/card', locals: { title: 'Count' } do %>
    <span data-testid="card-count"><%= count %></span>
  <% end %>
  <%= card 'Helper' do %>
    <span data-testid="helper-card-count"><%= count %></span>
  <% end %>
  <% presenter = card_presenter %>
  <%= presenter.card 'Presenter' do %>
    <span data-testid="presenter-card-count"><%= count %></span>
  <% end %>
</div>
